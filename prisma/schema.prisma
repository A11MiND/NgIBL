// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

// ─── RBAC ───────────────────────────────────────────────────────────

enum Role {
  STUDENT
  TEACHER
  ADMIN
}

enum MembershipRole {
  OWNER
  ADMIN
  TEACHER
  STUDENT
}

enum MembershipStatus {
  INVITED
  ACTIVE
  SUSPENDED
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Platform {
  IBL
  ENGLISH_LEARNING
  LEARNING_ASSISTANT
}

model Organization {
  id          String   @id @default(uuid())
  name        String
  slug        String   @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships UserOrganizationMembership[]
  users       User[]
  subscriptions OrgSubscription[]
  entitlements Entitlement[]
  classrooms  Classroom[]
  experiments Experiment[]
  simulations Simulation[]
  auditLogs   AuditLog[]

  @@index([slug])
}

model UserOrganizationMembership {
  id             String           @id @default(uuid())
  userId         String
  organizationId String
  role           MembershipRole   @default(STUDENT)
  status         MembershipStatus @default(ACTIVE)
  invitedBy      String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([userId, organizationId])
  @@index([organizationId, role])
}

model OrgSubscription {
  id             String             @id @default(uuid())
  organizationId String
  planCode       String
  status         SubscriptionStatus @default(TRIAL)
  startedAt      DateTime           @default(now())
  endsAt         DateTime?
  metadata       Json?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
}

model Entitlement {
  id             String   @id @default(uuid())
  organizationId String
  key            String
  enabled        Boolean  @default(true)
  quota          Int?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, key])
  @@index([organizationId])
}

model Classroom {
  id             String   @id @default(uuid())
  organizationId String
  name           String
  code           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  enrollments  ClassroomEnrollment[]

  @@unique([organizationId, name])
  @@index([organizationId])
}

model ClassroomEnrollment {
  id            String   @id @default(uuid())
  classroomId   String
  userId        String
  studentNumber String?
  createdAt     DateTime @default(now())

  classroom Classroom @relation(fields: [classroomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([classroomId, userId])
  @@index([userId])
}

model GlobalUser {
  id        String   @id @default(uuid())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  mappings PlatformUserMapping[]
}

model PlatformUserMapping {
  id           String   @id @default(uuid())
  globalUserId String
  platform     Platform
  localUserId  String
  userId       String?
  createdAt    DateTime @default(now())

  globalUser GlobalUser @relation(fields: [globalUserId], references: [id], onDelete: Cascade)
  user       User?      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([platform, localUserId])
  @@index([userId])
}

model User {
  id        String   @id @default(uuid())
  globalUserId String?
  organizationId String?
  email     String   @unique
  password  String
  name      String?
  role      Role     @default(TEACHER)
  createdAt DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  memberships  UserOrganizationMembership[]
  classroomEnrollments ClassroomEnrollment[]
  platformMappings PlatformUserMapping[]
  
  experiments Experiment[]
  simulations Simulation[]
  submissions StudentSubmission[]
  geminiApiKey  String?
  deepseekApiKey String?
  qwenApiKey     String?
  ollamaBaseUrl  String?  // default http://localhost:11434
  preferredProvider String? // gemini | deepseek | qwen | ollama
  modelProviders Json? // dynamic provider templates + user API credentials/config
  deepseekCredits Int @default(200) // starter credits that can be customized in settings
  defaultModel   String?  // e.g. deepseek-chat, qwen-plus, gemini-1.5-flash

  // Per-function model overrides
  simulationModel String?  // Model for AI simulation generation
  chatbotModel    String?  // Model for student AI tutor chatbot
  analysisModel   String?  // Model for analysing student submissions

  // Audit trail
  auditLogs  AuditLog[]

  @@index([organizationId])
  @@index([email])
  @@index([role])
  @@index([createdAt])
}

model Experiment {
  id             String   @id @default(uuid())
  title          String
  slug           String   @unique
  description    String?
  subject        String
  isPublished    Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  aiContext      String?  // For RAG
  aiModel        String   @default("gemini")
  systemPrompt   String?
  temperature    Float    @default(0.7)
  allowImageUpload Boolean @default(false)

  userId         String?
  organizationId String?
  user           User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)

  simulationId   String?
  simulation     Simulation? @relation(fields: [simulationId], references: [id])

  questions      WorksheetQuestion[]
  submissions    StudentSubmission[]
  embeddings     Embedding[]
  analysisRuns   AnalysisRun[]
  questionMetricSnapshots QuestionMetricSnapshot[]
  studentProgressSnapshots StudentProgressSnapshot[]

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([subject])
  @@index([isPublished])
  @@index([slug])
}

model WorksheetQuestion {
  id          String   @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  type        String   // MCQ, SHORT, LONG, FILL_IN
  question    String
  options     Json?    // For MCQ options: ["Option A", "Option B"]
  order       Int      @default(0)
  
  answers     Answer[]

  @@index([experimentId, order])
}

model StudentSubmission {
  id           String   @id @default(uuid())
  experimentId String
  userId       String?
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  user         User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  studentName  String
  studentId    String
  class        String
  submittedAt  DateTime @default(now())
  
  answers      Answer[]

  @@index([experimentId, submittedAt])
  @@index([userId])
  @@index([studentId])
}

model Answer {
  id           String   @id @default(uuid())
  submissionId String
  submission   StudentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  questionId   String
  question     WorksheetQuestion @relation(fields: [questionId], references: [id])
  value        String

  @@index([submissionId])
  @@index([questionId])
}

model Simulation {
  id          String   @id @default(uuid())
  title       String
  description String?
  subject     String   // Physics, Chemistry, Biology, Math
  
  // Type & Content
  type        String   // "REACT" | "GEOGEBRA_FILE" | "GEOGEBRA_API"
  reactCode   String?  // JSX code for React sims
  geogebraFile String? // URL to .ggb file (Vercel Blob)
  geogebraMaterialId String? // geogebra.org material ID
  geogebraCommands Json? // AI-generated commands array
  geogebraSettings Json? // API config (width, height, toolbar)
  
  // Metadata
  variables   Json?    // AI-detected variables [{name, type, min, max}]
  thumbnail   String?  // Preview image URL
  
  // Community
  isPublic    Boolean  @default(false)
  isTemplate  Boolean  @default(false) // Migrated prebuilts
  views       Int      @default(0)
  forks       Int      @default(0)
  parentId    String?  // For forked simulations
  parent      Simulation? @relation("SimulationForks", fields: [parentId], references: [id])
  children    Simulation[] @relation("SimulationForks")
  
  // Version Control
  versionHistory Json? // [{version, code, timestamp, changes}]
  chatHistory    Json? // [{role, content, images?, timestamp?}]
  
  // Relations
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  userId      String
  organizationId String?
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  
  experiments Experiment[]

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([isPublic])
  @@index([subject])
}

// ─── RAG: Vector Embeddings ─────────────────────────────────────────

model Embedding {
  id           String   @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  chunkText    String
  chunkIndex   Int
  embedding    Unsupported("vector(768)")?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([experimentId])
}

// ─── Audit Logging ──────────────────────────────────────────────────

model AuditLog {
  id        String   @id @default(uuid())
  userId    String
  organizationId String?
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organization Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  action    String   // CREATE, UPDATE, DELETE, LOGIN, etc.
  entity    String   // Experiment, Simulation, etc.
  entityId  String?
  metadata  Json?    // Additional context
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([organizationId, createdAt])
  @@index([entity, action])
}

// ─── Progress Monitoring Snapshots ─────────────────────────────────

model AnalysisRun {
  id           String   @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  kind         String   // CLASS_ANALYSIS | CLASS_COMPARE | STUDENT_ANALYSIS
  classA       String?
  classB       String?
  model        String?
  provider     String?
  status       String   @default("SUCCESS") // SUCCESS | FAILED
  error        String?
  durationMs   Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  @@index([experimentId, createdAt])
  @@index([kind, createdAt])
}

model QuestionMetricSnapshot {
  id           String   @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  questionId   String
  className    String?
  correctPct   Float
  partialPct   Float
  incorrectPct Float
  sampleSize   Int
  createdAt    DateTime @default(now())

  @@index([experimentId, createdAt])
  @@index([questionId, createdAt])
  @@index([className, createdAt])
}

model StudentProgressSnapshot {
  id              String   @id @default(uuid())
  experimentId    String
  experiment      Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  studentId       String
  studentName     String
  className       String
  submissionId    String?
  progressScore   Float    // 0-100 composite score
  strengths       Json?
  weaknesses      Json?
  metrics         Json?
  createdAt       DateTime @default(now())

  @@index([experimentId, studentId, createdAt])
  @@index([className, createdAt])
}
